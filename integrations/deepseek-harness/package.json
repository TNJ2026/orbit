{
  "name": "@orbit-runtime/dsh-orbit",
  "description": "DeepSeek Harness Host bundle for the Orbit MCP runtime",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "cordis.patch.yml",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.2"
  },
  "scripts": {
    "build": "tsc && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke:profile": "npm run build && node tests/profile-smoke.mjs"
  }
}
